# 업비트 API 키 (절대 GitHub에 올리지 마세요!)
UPBIT_ACCESS_KEY=여기에_액세스키_입력
UPBIT_SECRET_KEY=여기에_시크릿키_입력

# 거래 대상
TICKER=KRW-BTC

# ── 예산 / 포지션 사이징 ─────────────────────
BUDGET=1000000             # 총 배정 예산 (원)
POSITION_PCT=0.15          # 1회 진입 비율 (유효예산 대비) — 0.10~0.20 권장
MIN_ORDER_KRW=5000         # 업비트 최소 주문 금액

# ── 손절 / 분할 익절 ─────────────────────────
MAX_STOP_LOSS=-0.02        # 손절 한도 -2%
ATR_STOP_MULT=1.5          # ATR 기반 손절 배수 (한도 내에서 적용)
TP1_PCT=0.015              # 1차 익절 +1.5%
TP1_RATIO=0.50             # 1차에서 매도할 초기 수량 비율
TP2_PCT=0.030              # 2차 익절 +3.0%
TP2_RATIO=0.30             # 2차에서 매도할 초기 수량 비율
TRAILING_STOP_PCT=0.012    # 잔여 물량 트레일링 -1.2%

# ── 일일 리스크 한도 ─────────────────────────
DAILY_LOSS_LIMIT_PCT=0.03  # 일일 손실 한도 (예산 대비 -3%)
MAX_CONSECUTIVE_STOPS=3    # 연속 손절 횟수 도달 시 당일 거래 중단

# ── 안전 장치 ───────────────────────────────
SLIPPAGE_LIMIT_PCT=0.005   # 시장가 주문 슬리피지 한도 0.5%
API_ERROR_LIMIT=3          # 연속 API 오류 한도

# ── 대시보드 ────────────────────────────────
DASHBOARD_PASSWORD=         # 대시보드 접속 비밀번호 (비워두면 인증 없음 — 절대 비추천)
DASHBOARD_PORT=8501         # 대시보드 포트
