# 업비트 API 키 (절대 GitHub에 올리지 마세요!)
UPBIT_ACCESS_KEY=여기에_액세스키_입력
UPBIT_SECRET_KEY=여기에_시크릿키_입력

# 거래 대상
TICKER=KRW-BTC

# ── 예산 / 포지션 사이징 ─────────────────────
# 총 배정 예산 (원)
BUDGET=1000000
# 1회 진입 비율 (유효예산 대비) — 0.10~0.20 권장
POSITION_PCT=0.12
# 업비트 최소 주문 금액
MIN_ORDER_KRW=10000

# ── 손절 / 분할 익절 ─────────────────────────
# 손절 한도 (-2%)
MAX_STOP_LOSS=-0.02
# ATR 기반 손절 배수
ATR_STOP_MULT=1.5
# 1차 익절 (+1.5%)에서 매도할 초기 수량 비율
TP1_PCT=0.015
TP1_RATIO=0.50
# 2차 익절 (+3.0%)에서 매도할 초기 수량 비율
TP2_PCT=0.030
TP2_RATIO=0.30
# 잔여 물량 트레일링 -1.8%
TRAILING_STOP_PCT=0.018

# ── 일일 리스크 한도 ─────────────────────────
# 일일 손실 한도 (예산 대비 -3%)
DAILY_LOSS_LIMIT_PCT=0.03
# 연속 손절 횟수 도달 시 당일 거래 중단
MAX_CONSECUTIVE_STOPS=3

# ── 안전 장치 ───────────────────────────────
# 시장가 주문 슬리피지 한도 0.5%
SLIPPAGE_LIMIT_PCT=0.005
# 연속 API 오류 한도
API_ERROR_LIMIT=3

# 손절/TP/트레일링 체크 주기 (분). 매수는 항상 매 정시에만 평가됨.
# 포지션 보유 중일 때만 실제 동작. 1~5 권장.
EXIT_CHECK_INTERVAL_MIN=1

# ── 대시보드 ────────────────────────────────
# 대시보드 접속 비밀번호 (비워두면 인증 없음 — 절대 비추천)
DASHBOARD_PASSWORD=
# 대시보드 포트
DASHBOARD_PORT=8501
# 대시보드 자동 새로고침 주기 (초). 1H봉 매매라 60초로 충분. 짧을수록 업비트 API 호출 빈도↑
DASHBOARD_REFRESH_SEC=60
# 시장 스냅샷/잔고/거래내역 캐시 TTL (초). 보통 새로고침 주기와 같게 둠
DASHBOARD_CACHE_TTL_SEC=60
