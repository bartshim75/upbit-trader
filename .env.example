# 업비트 API 키 (절대 GitHub에 올리지 마세요!)
UPBIT_ACCESS_KEY=여기에_액세스키_입력
UPBIT_SECRET_KEY=여기에_시크릿키_입력

# 거래 대상 (BTC 기본 운용)
TICKER=KRW-BTC

# ── 예산 / 포지션 사이징 ─────────────────────
# 총 배정 예산 (원)
BUDGET=1000000
# 1회 진입 비율 (유효예산 대비) — 0.10~0.20 권장
POSITION_PCT=0.12
# 업비트 최소 주문 금액
MIN_ORDER_KRW=10000

# ── 손절 / 분할 익절 ─────────────────────────
# 손절 한도 (-2%)
MAX_STOP_LOSS=-0.02
# ATR 기반 손절 배수
ATR_STOP_MULT=1.5
# 1차 익절 (+1.5%)에서 매도할 초기 수량 비율
TP1_PCT=0.015
TP1_RATIO=0.50
# 2차 익절 (+3.0%)에서 매도할 초기 수량 비율
TP2_PCT=0.030
TP2_RATIO=0.30
# 잔여 물량 트레일링 -1.8%
TRAILING_STOP_PCT=0.018

# ── 평균회귀 전략 (BB 하단, 횡보장용) ─────────
# 볼린저 밴드 기간 / 표준편차 배수
BB_PERIOD=20
BB_STD=2.0
# BB 하단 진입 허용 톨러런스 (저가 ≤ 하단 × (1+BB_TOL))
BB_TOL=0.005
# 진입 시 RSI 상한 (이보다 낮을 때만 매수)
BB_RSI_MAX=45
# BB 모드 손절 ATR 배수 (와이드 스탑)
BB_ATR_STOP_MULT=3.0
# 진입 후 최대 보유 시간 (시간봉 단위, 도달 시 TIMEOUT 청산)
BB_MAX_HOLD_BARS=48
# 폭락 회피: P > MA200 × BB_MA200_FLOOR 일 때만 매수
BB_MA200_FLOOR=0.85

# ── Regime 감지 (매수 평가 시) ─────────────────
# MA200 기울기 lookback 봉수 (시간봉 50 = 약 2일)
REGIME_LOOKBACK_BARS=50
# MA200이 lookback 대비 이 비율 이상 우상향이면 TREND
REGIME_TREND_SLOPE_MIN=0.005
# P가 MA200 ±이 비율 안이면 SIDEWAYS 후보 (5%)
REGIME_SIDEWAYS_BAND=0.05
# MA200 slope < -이 값이면 BEAR (매수 차단)
REGIME_BEAR_SLOPE_MAX=0.005

# ── 일일 리스크 한도 ─────────────────────────
# 일일 손실 한도 (예산 대비 -3%)
DAILY_LOSS_LIMIT_PCT=0.03
# 연속 손절 횟수 도달 시 당일 거래 중단
MAX_CONSECUTIVE_STOPS=3

# ── 안전 장치 ───────────────────────────────
# 시장가 주문 슬리피지 한도 0.5%
SLIPPAGE_LIMIT_PCT=0.005
# 연속 API 오류 한도
API_ERROR_LIMIT=3

# ── 추가 운용 종목: DOGE ─────────────────────
# 최근 90일 ETH 대비 DOGE 상대 추세 우위 기준으로 기본 활성화.
# 비활성화하려면 ENABLE_DOGE=false
ENABLE_DOGE=true
DOGE_TICKER=KRW-DOGE
DOGE_BUDGET=300000
DOGE_POSITION_PCT=0.12
DOGE_MIN_ORDER_KRW=10000

# DOGE 맞춤 손절/익절: BTC보다 변동성·슬리피지를 넓게 허용
DOGE_MAX_STOP_LOSS=-0.025
DOGE_ATR_STOP_MULT=2.0
DOGE_TP1_PCT=0.020
DOGE_TP1_RATIO=0.45
DOGE_TP2_PCT=0.045
DOGE_TP2_RATIO=0.30
DOGE_TRAILING_STOP_PCT=0.025

# DOGE 맞춤 1H 지표: 더 빠른 추세/눌림 감지
DOGE_MA_TREND_LONG=160
DOGE_MA_TREND_MID=34
DOGE_MA_PULLBACK=12
DOGE_MA_PULLBACK_TOLERANCE=0.012
DOGE_RSI_BUY_MIN=35
DOGE_RSI_BUY_MAX=62
DOGE_VOLATILITY_HALT_MULT=3.5
DOGE_SLIPPAGE_LIMIT_PCT=0.008

# DOGE 맞춤 횡보장 평균회귀
DOGE_BB_STD=2.2
DOGE_BB_TOL=0.012
DOGE_BB_RSI_MAX=50
DOGE_BB_ATR_STOP_MULT=3.2
DOGE_BB_MAX_HOLD_BARS=36
DOGE_BB_MA200_FLOOR=0.82

# DOGE 리스크 한도
DOGE_DAILY_LOSS_LIMIT_PCT=0.035
DOGE_MAX_CONSECUTIVE_STOPS=2

# 손절/TP/트레일링 체크 주기 (분). 매수는 항상 매 정시에만 평가됨.
# 포지션 보유 중일 때만 실제 동작. 1~5 권장.
EXIT_CHECK_INTERVAL_MIN=1

# ── 대시보드 ────────────────────────────────
# 대시보드 접속 비밀번호 (비워두면 인증 없음 — 절대 비추천)
DASHBOARD_PASSWORD=
# 대시보드 포트
DASHBOARD_PORT=8501
# 대시보드 자동 새로고침 주기 (초). 1H봉 매매라 60초로 충분. 짧을수록 업비트 API 호출 빈도↑
DASHBOARD_REFRESH_SEC=60
# 시장 스냅샷/잔고/거래내역 캐시 TTL (초). 보통 새로고침 주기와 같게 둠
DASHBOARD_CACHE_TTL_SEC=60
